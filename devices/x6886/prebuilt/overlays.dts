	fragment@33 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "tc,charger";
			enable_sw_jeita;
			enable_hv_charging;
			enable_sw_safety_timer;
			support_allround_bypass;
			support_real_soc_decimal;
			ftm_cp_num = <0x01>;
			enable_dynamic_mivr;
