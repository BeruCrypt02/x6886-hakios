/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = "printk.devkmsg=on";
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,disp-leds";

			backlight {
				led-mode = <0x04>;
				pwm_config = <0x00 0x01 0x00 0x00 0x00>;
				max-brightness = <0x13ff>;
				max-hw-brightness = <0x13ff>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			tran_ldo@28 {
				compatible = "tran,tran_ldo";
				reg = <0x28>;

				regulators {

					TRANLDO13 {
						regulator-name = "TRANLDO13";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x37>;
					};

					TRANLDO23 {
						regulator-name = "TRANLDO23";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x05>;
					};

					TRANLDO33 {
						regulator-name = "TRANLDO33";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x36>;
					};

					TRANLDO43 {
						regulator-name = "TRANLDO43";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x3a>;
					};
				};
			};

			hl1280-audioswitch@42 {
				compatible = "mediatek,hl1280-audioswitch";
				reg = <0x42>;
				status = "okay";
				phandle = <0x42>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			lcm_rst_out0_gpio {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x5500>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm_rst_out1_gpio {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0x5500>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm_dsi_te {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0x5301>;
				};
			};

			dispdefault {
				phandle = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "dispdefault\0lcm_rst_out0_gpio\0lcm_rst_out1_gpio\0mode_te_te";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			pinctrl-2 = <0x03>;
			pinctrl-3 = <0x04>;
			status = "okay";
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "dispdefault\0lcm_rst_out0_gpio\0lcm_rst_out1_gpio\0mode_te_te";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			pinctrl-2 = <0x03>;
			pinctrl-3 = <0x04>;
			helper-value = <0x00 0x01 0x01 0x01 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x01 0x01 0x01 0x01 0x00 0x01 0x01 0x01 0x00 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x01 0x01 0x00 0x01 0x00 0x00 0x00 0x01 0x00 0x00 0x00>;
			status = "okay";
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			panel1@0 {
				compatible = "nt37706a,fhdp,dsi,vdo,dsc,boe,boe,144hz,x6886";
				reg = <0x00>;
				vddi-gpios = <0xffffffff 0x31 0x00>;
				dvdd-supply = <0x05>;
				vci-gpios = <0xffffffff 0x3d 0x00>;
				reset-gpios = <0xffffffff 0x55 0x00>;
				pinctrl-names = "default";
				doze_backlight = <0x03 0x02 0x0f 0x1d>;

				port {

					endpoint {
						remote-endpoint = <0x06>;
						phandle = <0x07>;
					};
				};
			};

			panel2@0 {
				compatible = "vtdr6126a,fhdp,dsi,vdo,dsc,tm,tm,144hz,x6886";
				reg = <0x01>;
				vddi-gpios = <0xffffffff 0x31 0x00>;
				dvdd-supply = <0x05>;
				vci-gpios = <0xffffffff 0x3d 0x00>;
				reset-gpios = <0xffffffff 0x55 0x00>;
				pinctrl-names = "default";
				doze_backlight = <0x03 0x02 0x0f 0x1d>;

				port {

					endpoint {
						remote-endpoint = <0x06>;
						phandle = <0x43>;
					};
				};
			};

			ports {

				port {

					endpoint {
						remote-endpoint = <0x07>;
						phandle = <0x06>;
					};
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			tran_audio_controller {
				compatible = "tran-audio-controller";
				tran_pa_type = <0x02>;
				tran_typec_type = <0x02>;
				typec_usb_change_gpio = <0xffffffff 0x76 0x00>;
				phandle = <0x44>;
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			aw87xxx_pa@58 {
				compatible = "awinic,aw87xxx_pa";
				reg = <0x58>;
				dev_index = <0x01>;
				status = "okay";
			};

			aw87xxx_pa@59 {
				compatible = "awinic,aw87xxx_pa";
				reg = <0x59>;
				dev_index = <0x00>;
				status = "okay";
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;
			status = "okay";

			tms_nfc@28 {
				status = "okay";
				compatible = "tms,nfc";
				reg = <0x28>;
				tms,device-name = "tms_nfc";
				tms,device-count = <0x01>;
				tms,irq-gpio = <0xffffffff 0x01 0x00>;
				tms,ven-gpio = <0xffffffff 0x41 0x00>;
				tms,download-gpio = <0xffffffff 0x08 0x00>;
				phandle = <0x45>;
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {

			blkio {
				atomic_storage_io_enable = <0x01>;
				flash_type = <0x01>;
				phandle = <0x46>;
			};
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {

			gps_default {
				phandle = <0x08>;
			};

			gps_l1_lna@0 {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					output-low;
				};
			};

			gps_l1_lna@1 {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0x1902>;
				};
			};

			gps_l1_lna@2 {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					output-high;
				};
			};

			gps_l5_lna@0 {
				phandle = <0x0c>;

				pins_cmd_dat {
					pinmux = <0x1a00>;
					output-low;
				};
			};

			gps_l5_lna@1 {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0x1a02>;
				};
			};

			gps_l5_lna@2 {
				phandle = <0x0e>;

				pins_cmd_dat {
					pinmux = <0x1a00>;
					output-high;
				};
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default\0gps_l1_lna_disable\0gps_l1_lna_dsp_ctrl\0gps_l1_lna_enable\0gps_l5_lna_disable\0gps_l5_lna_dsp_ctrl\0gps_l5_lna_enable";
			pinctrl-0 = <0x08>;
			pinctrl-1 = <0x09>;
			pinctrl-2 = <0x0a>;
			pinctrl-3 = <0x0b>;
			pinctrl-4 = <0x0c>;
			pinctrl-5 = <0x0d>;
			pinctrl-6 = <0x0e>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {

			home {
				linux,keycodes = <0x25d>;
				wakeup-source;
			};
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			min-volt = <0x2dc6c0>;
			max-volt = <0x3567e0>;
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {
			supplier-num = <0x02>;
			supplier-vendor-0 = "BOE";
			supplier-0 = "nt37706a_fhdp_dsi_vdo_dsc_boe_boe_144hz_x6886, focaltech, ft3682g";
			supplier-vendor-fwname-0 = "focaltech_ts_fw.bin";
			supplier-resolution-0 = <0x10>;
			supplier-vendor-1 = "TM";
			supplier-1 = "vtdr6126a_fhdp_dsi_vdo_dsc_tm_tm_144hz_x6886, chipsemi, chct5560";
			supplier-vendor-fwname-1 = "chipsemi_ts_fw.bin";
			supplier-resolution-1 = <0x10>;
			touchscreen,fingerprint-support;
			touchscreen,dynamic-report-rate-support;
			touchscreen,pocket-mode-amt-support;
			touchscreen,esports-engine = <0x02>;
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {

			touch@0 {
				compatible = "focaltech,fts\0chipsemi,chsc_cap_touch";
				reg = <0x00>;
				status = "ok";
				spi-max-frequency = <0x7a1200>;
				interrupt-parent = <0xffffffff>;
				vtouch-supply = <0xffffffff>;
				focaltech,iovdd-gpio = <0xffffffff 0x0f 0x00>;
				focaltech,irq-gpio = <0xffffffff 0x0c 0x00>;
				focaltech,reset-gpio = <0xffffffff 0x74 0x00>;
				focaltech,avdd-gpio = <0xffffffff 0x96 0x00>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,display-coords = <0x00 0x00 0x437f 0x95ff>;
				focaltech,fod-function-support;
				focaltech,custom-mistouch-support;
				focaltech,pocket-function-support;
				focaltech,switch-report-support;
				pinctrl-names = "default\0state_spi_mode";
				pinctrl-0 = <0x0f>;
				pinctrl-1 = <0x10>;
				chipsemi,int-gpio = <0xffffffff 0x0c 0x00>;
				chipsemi,rst-gpio = <0xffffffff 0x74 0x00>;
				chipsemi,vdd-gpio = <0xffffffff 0x96 0x00>;
				chipsemi,vddio-gpio = <0xffffffff 0x0f 0x00>;
				chipsemi,x-coords = <0x437f>;
				chipsemi,y-coords = <0x95ff>;
				chipsemi,multiple-solution = <0x10>;
				chipsemi,fp_x_center = <0x21c>;
				chipsemi,fp_y_center = <0x87d>;
				chipsemi,fp_radius = <0x3f>;
				chipsemi,fod-function-support;
				chipsemi,pocket-function-support;
				chipsemi,switch-report-support;
				chipsemi,custom-mistouch-support;
				chipsemi,rawdata_limits_row = <0x28>;
				chipsemi,rawdata_limits_col = <0x12>;
				chipsemi,short_limits = <0x2bc>;
				invalid_row_col = <0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
