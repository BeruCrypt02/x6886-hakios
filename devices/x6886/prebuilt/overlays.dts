	fragment@24 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			mediatek,use-open-drain;

			upm7610@60 {
				compatible = "unisemipower,upm7610";
				reg = <0x60>;
				status = "okay";
				up-tcpc,name = "type_c_port0";
				up-tcpc,role-def = <0x05>;
				up-tcpc,rp-level = <0x00>;
				up-tcpc,vconn-supply = <0x01>;
				rt-tcpc,notifier_supply_num = <0x03>;
				upm7610pd,intr-gpio = <0xffffffff 0x45 0x00>;
				upm7610pd,intr-gpio-num = <0x45>;

				pd-data {
					pd,vid = <0x362f>;
					pd,pid = <0x7610>;
					pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,sink-cap-ext = <0xcf291117 0x00 0x100 0x00 0x10b010a 0xa000000>;
					pd,mfrs = "UnisemipowerTCPC";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x02>;
					pd,source-pdo-data = <0x26019032 0x260190c8>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x190c8>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd140362f 0x00 0x76100000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x362f>;
						bat,pid = <0x7610>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm-caps {
					local-dr-power;
					local-dr-data;
					local-usb-comm;
					local-no-suspend;
					pr-check = <0x00>;
					dr-check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};
		};
	};

	fragment@25 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sc-swchg@6b {
				compatible = "southchip,sc8950\0mediatek,sgm41516d";
				reg = <0x6b>;
				sc8950,intr_gpio = <0xffffffff 0x04 0x00>;
				status = "okay";
				phys = <0xffffffff 0x03>;
				phy-names = "usb2-phy";
				usb = <0xffffffff>;
				chg_name = "primary_chg";
				chg_alias_name = "sc8950_chg";
				alias_name = "sgm41516d_chg";
				phandle = <0x49>;

				usb-otg-vbus {
					regulator-compatible = "usb-otg-vbus";
					regulator-name = "usb-otg-vbus";
					regulator-min-microvolt = <0x4a0150>;
					regulator-max-microvolt = <0x50df20>;
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0x124f80>;
					phandle = <0x4a>;
				};
			};
		};
	};

	fragment@26 {
		target = <0xffffffff>;

		__overlay__ {

